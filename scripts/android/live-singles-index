#!/usr/bin/env bash
set -euo pipefail

mkdir -p singles-evidence
if adb shell pm path az.tabletennis | grep '^package:'; then
    adb uninstall az.tabletennis
fi
./gradlew :app:assembleDebug :app:assembleDebugAndroidTest
adb install -t app/build/outputs/apk/debug/app-debug.apk
adb install -t app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk
adb logcat -c
result=0
adb shell am instrument -w -r -e class az.tabletennis.LiveSinglesIndexTest \
    az.tabletennis.test/az.tabletennis.FixtureTestRunner | tee singles-evidence/instrumentation.txt || result=$?
adb logcat -d -s SinglesIndexLive:I '*:S' | tee singles-evidence/timing.txt >> "$GITHUB_STEP_SUMMARY"
test "$result" -eq 0
grep -Fq 'OK (1 test)' singles-evidence/instrumentation.txt
adb exec-out run-as az.tabletennis cat files/live-singles-index.png > singles-evidence/result.png
test -s singles-evidence/result.png

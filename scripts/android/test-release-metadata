#!/usr/bin/env bash
set -euo pipefail

android_scripts=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
scratch=$(mktemp -d)
trap 'find "$scratch" -depth -delete' EXIT
cd -- "$scratch"
mkdir bin
export PATH="$scratch/bin:$PATH" GITHUB_REPOSITORY=example/TableTennisAz

cat > bin/gh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [[ $1 == release && $2 == list ]]; then
    [[ $* == *'--exclude-drafts'* && $* == *'--exclude-pre-releases'* ]]
    if [[ -s previous-tag ]]; then echo 1; else echo 0; fi
elif [[ $1 == api && $2 == "repos/$GITHUB_REPOSITORY/releases/latest" ]]; then
    cat previous-tag
elif [[ $1 == api && $* == *"ref=refs/tags/$(cat previous-tag)"* ]]; then
    base64 previous-version.properties
else
    echo 'Unexpected GitHub request.' >&2
    exit 1
fi
SH
chmod +x bin/gh

# arrange
: > previous-tag
printf 'versionName=0.4.0\nversionCode=4\n' > version.properties
cat > CHANGELOG.md <<'MD'
# Changelog

## Unreleased

- Future change.

## 0.4.0 - 2026-11-19

- Released change.

### Results

Read the latest results.

~~~markdown
## Example heading
~~~

Open a match for details.

## 0.3.0 - 2026-11-18

- Earlier change.
MD

# act
"$android_scripts/validate-release-candidate" candidate > metadata

# assert
diff -u <(printf 'version_name=0.4.0\nversion_code=4\n') metadata
diff -u <(printf '%s\n' '- Released change.' '' '### Results' '' 'Read the latest results.' \
    '' '~~~markdown' '## Example heading' '~~~' '' 'Open a match for details.') candidate/release-notes.md

# arrange
printf 'v0.9.0\n' > previous-tag
printf 'versionName=0.9.0\nversionCode=8\n' > previous-version.properties
printf 'versionName=0.10.0\nversionCode=9\n' > version.properties
printf '## 0.10.0 - 2026-11-20\n\n- Next release.\n' > CHANGELOG.md

# act
"$android_scripts/validate-release-candidate" candidate > metadata

# assert
diff -u <(printf 'version_name=0.10.0\nversion_code=9\n') metadata
diff -u <(printf '%s\n' '- Next release.') candidate/release-notes.md

reject_candidate() {
    # arrange
    printf 'versionName=%s\nversionCode=%s\n' "$1" "$2" > version.properties
    printf '%s\n\n- Change.\n' "$3" > CHANGELOG.md

    # act & assert
    if "$android_scripts/validate-release-candidate" rejected > metadata 2> error; then
        echo "Expected rejection: $4" >&2
        exit 1
    fi
    grep -Fq -- "$4" error || { cat error >&2; exit 1; }
    [[ ! -s metadata && ! -e rejected/release-notes.md ]]
}

reject_candidate '0.010.0' '9' '## 0.010.0 - 2026-11-20' 'Expected MAJOR.MINOR.PATCH'
reject_candidate '0.8.1' '9' '## 0.8.1 - 2026-11-20' 'versionName must be greater than 0.9.0'
reject_candidate '0.10.0' '10' '## 0.10.0 - 2026-11-20' 'versionCode must be 9 after 0.9.0'
reject_candidate '0.10.0' '9' '## 0.10.0' 'Missing dated changelog section for 0.10.0'
reject_candidate '0.10.0' '9' '## 0.10.1 - 2026-11-20' 'Missing dated changelog section for 0.10.0'
reject_candidate '0.10.0' '9' '## 0.10.0 - 2026-02-30' 'Invalid changelog date for 0.10.0'

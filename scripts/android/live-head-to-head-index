#!/usr/bin/env bash
set -euo pipefail

format=${1:?Provide singles or doubles}
case "$format" in
    singles) method=freshInstallShowsThePublishedSinglesScoreWithinFiveSeconds ;;
    doubles) method=freshInstallShowsThePublishedDoublesScoreWithinFiveSeconds ;;
    *) exit 2 ;;
esac
evidence="live-$format-evidence"
mkdir -p "$evidence"
if adb shell pm path az.tabletennis | grep '^package:'; then
    adb uninstall az.tabletennis
fi
./gradlew :app:assembleDebug :app:assembleDebugAndroidTest
adb install -t app/build/outputs/apk/debug/app-debug.apk
adb install -t app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk
adb logcat -c
result=0
adb shell am instrument -w -r -e class "az.tabletennis.LiveHeadToHeadIndexTest#$method" \
    az.tabletennis.test/az.tabletennis.FixtureTestRunner | tee "$evidence"/instrumentation.txt || result=$?
adb logcat -d -s HeadToHeadIndexLive:I '*:S' | tee "$evidence"/timing.txt >> "$GITHUB_STEP_SUMMARY"
test "$result" -eq 0
grep -Fq 'OK (1 test)' "$evidence"/instrumentation.txt
adb exec-out run-as az.tabletennis cat "files/live-$format-index.png" > "$evidence"/result.png
test -s "$evidence"/result.png
